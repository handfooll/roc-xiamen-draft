[Unit]
Description=Landing page lead intake
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/rea/server/lead.py
EnvironmentFile=/etc/rea/env
Environment=LEAD_DB=/var/lib/rea/leads.db PORT=8081 PYTHONUNBUFFERED=1
DynamicUser=yes
StateDirectory=rea
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
