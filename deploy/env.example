# /etc/rea/env  (chmod 600, owner root). Leave a value empty to switch the feature off.
# Email notifications (SSL, port 465). NOTIFY_TO may list several addresses separated by commas.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
# Bitrix24 incoming webhook, e.g. https://example.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX_WEBHOOK_URL=
